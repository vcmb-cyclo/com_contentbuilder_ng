<?xml version="1.0" encoding="utf-8" ?>
<metadata>
    <layout title="COM_CONTENTBUILDERNG_MENU_ITEM_LATEST">
        <message>COM_CONTENTBUILDERNG_SELECT_LATEST_MESSAGE</message>
        <config>
            <fields name="params" addfieldprefix="CB\Component\Contentbuilderng\Site\Field">
                <fieldset name="settings" group="settings" label="COM_CONTENTBUILDERNG_MENU_ITEM_LATEST">
                    <field required="true" message="COM_CONTENTBUILDERNG_SELECT_VIEW_REQUIRED" type="menuforms" label="COM_CONTENTBUILDERNG_SELECT_VIEW" description="COM_CONTENTBUILDERNG_SELECT_VIEW_DESC" name="form_id" default="" data-cb-menu-view-selector="true" validate="options" />
                    <field name="cb_theme_plugin" type="menutheme" default="" label="COM_CONTENTBUILDERNG_MENU_THEME_LABEL" description="COM_CONTENTBUILDERNG_MENU_THEME_DESC" data-cb-menu-default-key="cb_theme_plugin" data-cb-menu-inherit-value="" data-cb-menu-override="true" validate="options" />
                    <field type="menuoverridereset" label="COM_CONTENTBUILDERNG_RESET_TO_DEFAULT" description="COM_CONTENTBUILDERNG_RESET_TO_DEFAULT_DESC" name="cb_menu_reset" />

                    <field type="spacer" class="cb-menu-section-heading" label="COM_CONTENTBUILDERNG_MENU_OPTIONS_DETAILS" />
                    <field name="cb_show_details_back_button" type="menuinherit" class="form-select-color-state" default="-1" label="COM_CONTENTBUILDERNG_SHOW_BACK_BUTTON" description="COM_CONTENTBUILDERNG_SHOW_BACK_BUTTON_DESC" data-cb-menu-default-key="cb_show_details_back_button" data-cb-menu-inherit-value="-1" data-cb-menu-override="true" validate="options">
                        <option value="0">COM_CONTENTBUILDERNG_NO</option>
                        <option value="1">COM_CONTENTBUILDERNG_YES</option>
                    </field>
                    <field name="cb_show_author" type="menuinherit" class="form-select-color-state" default="-1" description="COM_CONTENTBUILDERNG_SHOW_AUTHOR_DESC" label="COM_CONTENTBUILDERNG_SHOW_AUTHOR" data-cb-menu-default-key="cb_show_author" data-cb-menu-inherit-value="-1" data-cb-menu-override="true" validate="options">
                        <option value="0">JNO</option>
                        <option value="1">JYES</option>
                    </field>
                    <field name="cb_latest" type="hidden" default="1" />
                </fieldset>
            </fields>
        </config>
    </layout>
</metadata>
