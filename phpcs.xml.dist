<?xml version="1.0"?>
<ruleset name="ContentBuilderNG">
    <description>PSR-12 coding standard for ContentBuilder NG (Joomla 6 / PHP 8.3).</description>

    <file>admin/src</file>
    <file>admin/layouts</file>
    <file>admin/services</file>
    <file>site/src</file>
    <file>site/layouts</file>
    <file>plugins</file>
    <file>script.php</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/coverage/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!--
        Legacy surface inherited from ContentBuilder/BreezingForms. These files
        predate the Joomla 6 rewrite and are queued for decomposition; sniffing
        them today would produce thousands of findings and drown new work.
        Remove entries here as each file is refactored.
    -->
    <rule ref="PSR12">
        <exclude-pattern>admin/src/types/*</exclude-pattern>
        <exclude-pattern>site/src/Model/EditModel.php</exclude-pattern>
        <exclude-pattern>admin/src/Model/VerifyModel.php</exclude-pattern>
    </rule>
</ruleset>
